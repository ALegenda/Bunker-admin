POSTGRES_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY=bunker
S3_SECRET_KEY=CHANGE_ME_TOO
S3_BUCKET=bunker
PORT=4173
HOST=127.0.0.1
# Local development only. Production refuses to start in this mode.
NODE_ENV=development
